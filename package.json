{
  "name": "mpb-visual-regression-tests",
  "version": "1.0.0",
  "description": "Visual regression testing suite for MPB applications using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "HEADLESS=false playwright test --headed",
    "test:debug": "HEADLESS=false SLOW_MO=1000 playwright test --debug",
    "test:swan": "playwright test tests/swan",
    "test:swan:headed": "HEADLESS=false playwright test tests/swan --headed",
    "test:swan:debug": "HEADLESS=false SLOW_MO=1000 DEVTOOLS=true playwright test tests/swan --debug",
    "test:swan:staging": "TLD=staging.env.mpb.com HEADLESS=false playwright test tests/swan --headed",
    "test:mobile": "MOBILE_VIEW=true playwright test",
    "test:mobile:headed": "MOBILE_VIEW=true HEADLESS=false playwright test --headed",
    "test:update": "playwright test --update-snapshots",
    "test:single": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:serve": "allure serve allure-results",
    "allure:open": "allure open allure-report",
    "test:allure": "npm run test:swan && npm run allure:generate && npm run allure:open",
    "install-browsers": "playwright install",
    "install-deps": "playwright install-deps"
  },
  "keywords": [
    "visual-testing",
    "playwright",
    "mpb",
    "regression"
  ],
  "dependencies": {
    "@playwright/test": "^1.45.0"
  },
  "devDependencies": {
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "dotenv": "^16.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
