# MPB Visual Regression Testing Environment Configuration
# Copy to .env and configure for your environment

# Target Environment
TLD=staging.env.mpb.com
PROTOCOL=https

# Test Execution
HEADLESS=true
MOBILE_VIEW=false
WORKERS=3

# Visual Testing
VISUAL_THRESHOLD=0.1

# Authentication (extracted from MPB test SDK)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# CI/CD Settings
CI=false